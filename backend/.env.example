# Copy to .env and fill in. Never commit the real .env.

# --- Telegram -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:replace-with-token-from-BotFather
# Random string Telegram echoes back in X-Telegram-Bot-Api-Secret-Token.
# Generate: python scripts/set_webhook.py generate-secret   (allowed chars: A-Z a-z 0-9 _ -)
TELEGRAM_WEBHOOK_SECRET=replace-with-generated-secret
# Public HTTPS base URL of this service (used only by scripts/set_webhook.py)
PUBLIC_BASE_URL=https://bot.example.com
WEBHOOK_PATH=/telegram/webhook
# Optional: the bot's @username, so commands addressed to other bots in groups are ignored
TELEGRAM_BOT_USERNAME=
# Comma-separated Telegram user IDs that are always administrators (send /start to the bot to see yours)
ADMIN_TELEGRAM_IDS=111111111
# Accept reports from group chats that an admin trusted with /trust_group
ALLOW_GROUP_SUBMISSIONS=false
# Minutes a summary can still be confirmed
CONFIRMATION_TTL_MINUTES=120

# --- Google Sheets ------------------------------------------------------------------------
# Path to the service-account JSON key (docker-compose mounts ./secrets/google-service-account.json here)
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json
# ...or paste the whole JSON key into one line instead (useful on Render):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Pick a tab automatically when no /set_worksheet mapping exists and exactly one tab is named
# for the loader, month and year (e.g. "Loader 11 nov 2026"). The tab is shown before confirmation.
WORKSHEET_AUTO_DETECT=true
# Locate columns by their header text (recommended); strict = every column must be recognised
SHEET_HEADER_DETECTION=true
SHEET_HEADER_STRICT=true
# Fallback / expected column letters (only keys you override are needed)
# SHEET_COLUMN_MAP={"DATE":"B","HSD_FUEL":"C","SHIFT_1_TRIPS":"D","SHIFT_1_WEIGHT":"E","SHIFT_1_AVG":"F","SHIFT_2_TRIPS":"G","SHIFT_2_WEIGHT":"H","SHIFT_2_AVG":"I","SHIFT_3_TRIPS":"J","SHIFT_3_WEIGHT":"K","SHIFT_3_AVG":"L","DAY_TOTAL_WEIGHT":"M","DAY_TOTAL_TRIPS":"N"}
SHEET_READ_MAX_ROWS=400
SHEET_READ_LAST_COLUMN=BZ

# --- Business rules -----------------------------------------------------------------------
# confirm | reject | admin_approval  (what to do when a shift already has data)
CORRECTION_POLICY=confirm
WEIGHT_DECIMALS=3
AVERAGE_DECIMALS=2
TOTALS_TOLERANCE_MT=0.001
TIMEZONE=Asia/Kolkata

# --- Storage & worker ---------------------------------------------------------------------
# Docker image default: sqlite:////app/data/app.db (on the persistent volume)
# Local development:    sqlite:///./data/app.db
# PostgreSQL:           postgresql://user:password@host:5432/loaderbot?sslmode=require
#                       (pooled endpoints such as Neon '-pooler' work; DB_URL is accepted as an alias)
# DATABASE_URL=sqlite:////app/data/app.db
RUN_WORKER_IN_PROCESS=true
WORKER_POLL_INTERVAL_SECONDS=2
JOB_MAX_ATTEMPTS=6
JOB_RETRY_BASE_SECONDS=15

# --- Logging ------------------------------------------------------------------------------
LOG_LEVEL=INFO
# json (for log aggregation) or text
LOG_FORMAT=json
APP_ENV=production
